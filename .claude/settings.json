{
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.envrc.local)",
      "Read(**/*.pem)",
      "Read(**/*.p12)",
      "Edit(.env)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.envrc.local)",
      "Bash(security find-generic-password:*)",
      "Bash(security dump-keychain:*)",
      "Bash(env)",
      "Bash(printenv:*)",
      "Bash(set)"
    ]
  }
}
