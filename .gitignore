# macOS
.DS_Store

# Python tooling inside .claude/skills
__pycache__/

# Xcode user state
xcuserdata/
*.xcuserstate
*.xcscmblueprint

# SPM (Package.resolved is committed for reproducible builds)
.build/
.swiftpm/

# Build artifacts
DerivedData/
*.dSYM/
*.app.zip

# Secrets (never committed; real keys live in Keychain)
*.pem
*.key
.env*
!.env.example

# .envrc holds a Keychain *lookup*, not a value, so it is safe to commit and is
# how live checks get their key (see Sources/ProviderTestSupport/LiveCredentials.swift).
# .envrc.local is direnv's per-machine override — the file people do put values
# in — so it stays ignored.
!.envrc
.envrc.local
.direnv/

# Personal Claude Code config. NEVER track: the permission allowlist records
# approved commands verbatim, so a secret typed inline on the command line
# lands here. This is exactly how PGPASSWORD leaked to the public remote
# (commit 7be9733). Shared config belongs in .claude/settings.json instead.
.claude/settings.local.json
