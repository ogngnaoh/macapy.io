# ============================================
# macapy.io Environment Configuration
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/macapy_db

# For Docker Compose deployment
POSTGRES_USER=macapy_user
POSTGRES_PASSWORD=macapy_password
POSTGRES_DB=macapy_db

# ============================================
# OpenAI API Configuration
# ============================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# ============================================
# Application Configuration
# ============================================
# Generate a secure random string for production:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-use-random-string
DEBUG=true

# ============================================
# Server Configuration
# ============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# ============================================
# Audio Configuration
# ============================================
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_DURATION=1.0

# ============================================
# AI Model Configuration
# ============================================
WHISPER_MODEL=whisper-1
GPT_MODEL=gpt-5-nano-2025-08-07
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# ============================================
# Vector Search Configuration
# ============================================
VECTOR_SIMILARITY_METRIC=cosine
VECTOR_TOP_K=5

# ============================================
# File Upload Configuration
# ============================================
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=backend/uploads

# ============================================
# Meeting Configuration
# ============================================
SUMMARY_INTERVAL=60
TRANSCRIPTION_LATENCY_TARGET=5
SUGGESTION_LATENCY_TARGET=8

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
LOG_FILE=logs/macapy.log
