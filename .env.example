# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/macapy_db

# OpenAI API Configuration
OPENAI_API_KEY=sk-your-api-key-here

# Application Configuration
SECRET_KEY=your-secret-key-here-use-random-string
DEBUG=true

# Server Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Audio Configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHANNELS=1
AUDIO_CHUNK_DURATION=1.0

# AI Model Configuration
WHISPER_MODEL=whisper-1
GPT_MODEL=gpt-4-turbo
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=384

# Vector Search Configuration
VECTOR_SIMILARITY_METRIC=cosine
VECTOR_TOP_K=5

# File Upload Configuration
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
UPLOAD_DIR=backend/uploads

# Meeting Configuration
SUMMARY_INTERVAL=60  # seconds
TRANSCRIPTION_LATENCY_TARGET=5  # seconds
SUGGESTION_LATENCY_TARGET=8  # seconds

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/macapy.log
