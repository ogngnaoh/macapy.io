{
  "name": "macapy-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Workspace root for macapy.io - AI-powered meeting assistant",
  "scripts": {
    "dev": "concurrently -k -n \"API,WEB\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "./scripts/start-backend.sh",
    "dev:frontend": "wait-on http://localhost:8000/docs -t 30000 && cd frontend && npm run dev",
    "dev:frontend:only": "cd frontend && npm run dev",
    "dev:backend:only": "./scripts/start-backend.sh",
    "install:all": "pip install -r backend/requirements.txt && cd frontend && npm install",
    "install:backend": "pip install -r backend/requirements.txt",
    "install:frontend": "cd frontend && npm install",
    "test": "npm run test:backend && npm run test:frontend",
    "test:backend": "cd backend && pytest tests/ -v",
    "test:frontend": "cd frontend && npm test",
    "lint": "cd frontend && npm run lint",
    "build": "cd frontend && npm run build",
    "clean": "rm -rf frontend/node_modules frontend/dist backend/__pycache__ backend/.pytest_cache"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  }
}
