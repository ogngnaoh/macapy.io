<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Decision (slice 3, 2026-07-16): the app ships UNSANDBOXED.
	     Distribution is Developer ID + notarization (SPEC §5, §8), not the App
	     Store. Core Audio process taps and the App Sandbox are a known bad mix
	     (a sandboxed app cannot create a global process tap / aggregate device),
	     so no com.apple.security.app-sandbox entitlement is added. System-audio
	     capture is instead gated at runtime by the AudioCapture TCC prompt
	     (Info.plist NSAudioCaptureUsageDescription / kTCCServiceAudioCapture);
     the mic by NSMicrophoneUsageDescription. Hardened runtime additionally
     requires the Audio Input entitlement; this does not grant TCC access. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
