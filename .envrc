# direnv: seeds the live-check key from the Keychain when you cd into the repo.
#
# There is no secret in this file — only a lookup — which is exactly why it is
# safe to commit. The value lives in a Keychain item you create once:
#
#     security add-generic-password -s io.macapy.dev -a deepseek -w
#
# `-w` with no value prompts interactively, so the key never enters shell
# history. Then run `direnv allow` once. Without direnv installed, `source
# .envrc` does the same thing for a single shell.
#
# A separate service from the app's own `io.macapy.app` on purpose: this is a
# scoped, cheaply-rotatable dev key, and deleting one must not disturb the
# other.
#
# The `|| true` matters. On a machine with no Keychain item the export yields
# "", and LiveCredentials treats empty as absent — so live suites skip cleanly
# rather than sending an empty bearer token upstream.
export MACAPY_DEEPSEEK_KEY="$(security find-generic-password -s io.macapy.dev -a deepseek -w 2>/dev/null || true)"
